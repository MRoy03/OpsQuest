# ============================================================
# OpsQuest Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ------------------------------------------------------------
# Supabase (REQUIRED for live data)
# Get from: supabase.com → Project → Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------
# Ollama (local AI — optional, enhances Problem Solver)
# Install: https://ollama.ai  then: ollama pull llama3.2
# Only works locally; Vercel falls back to Groq or keyword engine
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------
# Groq Cloud AI — FREE tier (Problem Solver fallback)
# Sign up at: https://console.groq.com → API Keys → Create
# Free tier: generous rate limits, no credit card needed
# Used when Ollama is unavailable; works on Vercel too
# ------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here

# ------------------------------------------------------------
# Entra ID / Azure Active Directory (Infrastructure Monitor)
# Create App Registration in Azure Portal:
#   Azure Portal → App registrations → New → API permissions:
#   Microsoft Graph → Application → User.Read.All, Device.Read.All,
#   AuditLog.Read.All, IdentityRiskyUser.Read.All → Grant admin consent
# ------------------------------------------------------------
ENTRA_TENANT_ID=your-azure-tenant-id
ENTRA_CLIENT_ID=your-app-registration-client-id
ENTRA_CLIENT_SECRET=your-app-registration-client-secret

# ------------------------------------------------------------
# Aruba Instant On (Infrastructure Monitor → Network)
# Get from: Aruba Instant On portal → Account → API Credentials
# ------------------------------------------------------------
ARUBA_CLIENT_ID=your-aruba-client-id
ARUBA_CLIENT_SECRET=your-aruba-client-secret

# ------------------------------------------------------------
# Sophos Central (Infrastructure Monitor → Network)
# Get from: Sophos Central → Global Settings → API Credentials Management
# Create Service Principal → copy Client ID and Client Secret
# ------------------------------------------------------------
SOPHOS_CLIENT_ID=your-sophos-central-client-id
SOPHOS_CLIENT_SECRET=your-sophos-central-client-secret

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
